<rml>
<head>
    <title>bw_login</title>
    <link type="text/rcss" href="../theme.rcss"/>
    <link type="text/rcss" href="../screens.rcss"/>
    <link type="text/rcss" href="../skin.rcss"/>
    <style>
        .bw-hidden { display: none; }
        .bw-tutorial-focus { border: 3dp #ffd34d; }
        .bw-tutorial { position: absolute; left: 10%; right: 10%; bottom: 12%; padding: 16dp; text-align: center; }
        .bw-col { display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .bw-menu { width: 320dp; max-width: 90%; }
    </style>
</head>
<body>
<div class="root" data-model="meta">
    <div class="screen" data-attr-style="safeStyle">
        <div class="screen-body bw-col">
            <h1>{{bw.t.title}}</h1>
            <div class="bw-menu">
                <button class="big primary" id="bw-login" onclick="bw.login()">{{bw.t.login}}</button>
                <button class="big" onclick="game.start(0, {})">{{bw.t.offline}}</button>
                <p class="muted">{{bw.status}}</p>
            </div>
        </div>
        <div class="bw-tutorial panel" data-if="bw.tutorial.visible" onclick="bw.tap(nil)">{{bw.tutorial.text}}</div>
    </div>
</div>
</body>
</rml>
