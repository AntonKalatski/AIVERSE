<rml>
<head>
    <title>bw_clan</title>
    <link type="text/rcss" href="../theme.rcss"/>
    <link type="text/rcss" href="../screens.rcss"/>
    <link type="text/rcss" href="../skin.rcss"/>
    <style>
        .bw-hidden { display: none; }
        .bw-tutorial-focus { border: 3dp #ffd34d; }
        .bw-tutorial { position: absolute; left: 10%; right: 10%; bottom: 12%; padding: 16dp; text-align: center; }
        .bw-col { display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .bw-menu { width: 320dp; max-width: 90%; }
    </style>
</head>
<body>
<div class="root" data-model="meta">
    <div class="screen" data-attr-style="safeStyle">
        <div class="screen-header">
            <button class="back" onclick="ui.back()">{{bw.t.back}}</button>
            <div class="screen-title">{{bw.t.clan}}</div>
            <div class="currencies">
                <span class="currency">{{bw.gold}} <span class="muted">{{bw.t.gold}}</span></span>
                <span class="currency">{{bw.gems}} <span class="muted">{{bw.t.gems}}</span></span>
            </div>
        </div>
        <div class="screen-body">
            <p data-if="bw.inClan">#{{bw.clan.clanId}}</p>
            <p class="muted" data-if="!bw.inClan">{{bw.t.no_clan}}</p>
            <div class="list">
                <div class="list-row" data-for="c : bw.clans">
                    <span class="grow">{{c.name}}</span><span class="muted">{{bw.t.members}} {{c.members}}</span>
                    <button class="secondary" data-if="!bw.inClan" data-event-click="call('bw.joinClan', c.id)">{{bw.t.join}}</button>
                </div>
            </div>
        </div>
        <div class="bw-tutorial panel" data-if="bw.tutorial.visible" onclick="bw.tap(nil)">{{bw.tutorial.text}}</div>
    </div>
</div>
</body>
</rml>
